/target
**/*.rs.bk
# Local-only scratch space — holds signing/notary credentials, never commit.
/ignore/
# Evidência de verificação local (runs isolados, logs, sandbox) — nunca commitada.
/.tmp/
*.pdb
.DS_Store
.env
.env.local
node_modules
.wrangler
build/
edge/dist/
.auto-code/
.reverse-engineering/
.plan-worktree-cutover.json
progress.md

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Orchestrator chat uploads written into the workspace at runtime
.orchestrator/

# Dormant card-web asset output
edge/public/
/scripts/**/__pycache__/

# Local agent worktrees and graft config — never committed.
/.claude/worktrees/
/.graft/
.dev.vars
.dev.vars.*
