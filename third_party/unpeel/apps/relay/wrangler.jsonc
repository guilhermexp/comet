{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unpeel-relay",
  "account_id": "abc947fba4af12bd510f8e6e7530c578",
  "compatibility_date": "2025-08-03",
  "main": "./src/worker.mjs",
  "observability": { "enabled": true },
  // The relay is E2E-blind plumbing: it verifies host entitlements (Ed25519,
  // public key below — the same key the Mac app embeds) and relayToken
  // hashes, then pipes ciphertext. See docs/feature/unpeel-remote.md.
  // Custom Domain (not a route): wrangler provisions the relay.unpeel.com DNS
  // record + edge certificate on first deploy, so a brand-new subdomain needs
  // no separate DNS step. The whole hostname maps to this Worker.
  "routes": [
    { "pattern": "relay.unpeel.com", "custom_domain": true }
  ],
  "vars": {
    "LICENSE_PUBLIC_KEY": "6RfwwHUhth8Ji7T7p/QbDOQjeN9Zrk1S34Hk85cpg54=",
    // Public Apple identifiers, kept in versioned config so only the private
    // APNs signing key and its rotation id need Worker secret provisioning.
    "APNS_TEAM_ID": "8M4MM4C2AH",
    "APNS_TOPIC": "com.unpeel.ios.remote"
  },
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MAC_RELAY", "class_name": "MacRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MacRelay"] }
  ]
}
