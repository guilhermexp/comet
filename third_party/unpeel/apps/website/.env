# Build-time feature flags (Vite inlines VITE_* at build time).
# Unpeel Remote went live 2026-07-23: the "Remote access" docs group is published.
VITE_UNPEEL_REMOTE=1
# The terminal UI / CLI shipped via unpeel.com/install.sh: publish its doc.
VITE_UNPEEL_TUI=1
# Unpeel Apps: publish the docs sidebar group and the /apps/skill.md agent
# skill (operator decision 2026-08-12, ahead of the first Apps shipping).
VITE_UNPEEL_APPS=1
